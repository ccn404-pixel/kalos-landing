---
// src/components/Process.astro
import { process } from "../data/content";
---

<section id={process.id} class="process" aria-labelledby="process-heading">
  <div class="container">
    <h2 id="process-heading">{process.heading}</h2>
    <p class="process__intro">{process.intro}</p>
    <ol class="process__steps" data-reveal-group data-reveal>
      {process.steps.map((step) => (
        <li data-reveal>
          <span class="process__number" aria-hidden="true">{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: var(--space-16);
  }

  .process__intro {
    max-width: 60ch;
  }

  .process__steps {
    position: relative;
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .process__steps::before {
    content: "";
    position: absolute;
    left: 1.25rem;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: linear-gradient(var(--teal-400), var(--border-on-light));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .js .process__steps.is-visible::before {
    transform: scaleY(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .process__steps::before {
      transform: scaleY(1);
    }
  }

  .process__steps li {
    position: relative;
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding-left: var(--space-6);
  }

  .process__number {
    position: relative;
    z-index: 1;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--teal-400);
    background: var(--navy-950);
    border-radius: 999px;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px var(--white);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .js [data-reveal].is-visible .process__number {
    animation: pop-number 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes pop-number {
    from {
      transform: scale(0.6);
    }
    to {
      transform: scale(1);
    }
  }

  .process__steps h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }
</style>
