---
// src/components/Services.astro
import { services } from "../data/content";
---

<section id={services.id} class="services" aria-labelledby="services-heading">
  <div class="container">
    <p class="eyebrow">{services.eyebrow}</p>
    <h2 id="services-heading">{services.heading}</h2>
    <p class="services__intro">{services.intro}</p>
    <ul class="services__grid" data-reveal-group>
      {services.items.map((item) => (
        <li class="card" data-reveal="left">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-16);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--navy-800);
    font-size: var(--text-sm);
    font-weight: 700;
    opacity: 0.65;
  }

  .services__intro {
    max-width: 60ch;
  }

  .services__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .card h3 {
    font-size: var(--text-lg);
  }
</style>
