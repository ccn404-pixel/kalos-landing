---
// src/components/WhyKalos.astro
import { Image } from "astro:assets";
import { whyKalos } from "../data/content";
import teamPhoto from "../assets/photos/team-collaboration.png";
---

<section id="why-kalos" class="why-kalos" aria-labelledby="why-kalos-heading">
  <div class="container" data-reveal>
    <h2 id="why-kalos-heading">{whyKalos.heading}</h2>
    <p class="why-kalos__intro">{whyKalos.intro}</p>
    <ul class="why-kalos__bullets">
      {whyKalos.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
    <p class="why-kalos__closing">{whyKalos.closing}</p>
  </div>

  <div class="why-kalos__proof">
    <Image src={teamPhoto} alt="" width={1600} height={900} class="why-kalos__photo" />
    <div class="why-kalos__scrim" aria-hidden="true"></div>
    <div class="why-kalos__quote-wrap" data-reveal>
      <div>
        <h3>{whyKalos.whyKalosHeading}</h3>
        <ol>
          {whyKalos.whyKalosItems.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </div>
      <blockquote class="why-kalos__quote">
        <p>{whyKalos.quote}</p>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .why-kalos {
    padding-block: var(--space-16) 0;
  }

  .why-kalos__intro,
  .why-kalos__closing {
    max-width: 65ch;
  }

  .why-kalos__closing {
    font-weight: 600;
  }

  .why-kalos__bullets {
    padding-left: var(--space-6);
  }

  .why-kalos__proof {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 420px;
    max-height: 620px;
    margin-top: var(--space-16);
    overflow: hidden;
    color: var(--white);
    display: flex;
    align-items: center;
  }

  .why-kalos__proof :global(.why-kalos__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    z-index: 0;
  }

  .why-kalos__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10, 14, 31, 0.9) 30%,
      rgba(10, 14, 31, 0.35) 80%
    );
    z-index: 1;
  }

  .why-kalos__quote-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-16) var(--space-6);
    max-width: var(--max-width);
    margin-inline: auto;
    width: 100%;
  }

  .why-kalos__quote {
    background: rgba(10, 14, 31, 0.55);
    border: 1px solid var(--border-on-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    font-style: italic;
    backdrop-filter: blur(4px);
  }

  @media (max-width: 780px) {
    .why-kalos__proof {
      display: block;
      aspect-ratio: auto;
      min-height: 0;
      max-height: none;
    }

    .why-kalos__proof :global(.why-kalos__photo) {
      position: static;
      aspect-ratio: 4 / 3;
      object-position: 50% 20%;
    }

    .why-kalos__scrim {
      background: linear-gradient(
        to top,
        rgba(10, 14, 31, 0.95) 20%,
        rgba(10, 14, 31, 0.6) 100%
      );
    }

    .why-kalos__quote-wrap {
      grid-template-columns: 1fr;
      position: static;
      padding-block: var(--space-8) var(--space-16);
    }
  }
</style>
