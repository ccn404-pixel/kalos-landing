---
// src/components/WhyKalos.astro
import { Image } from "astro:assets";
import { whyKalos } from "../data/content";
import teamPhoto from "../assets/photos/team-collaboration.png";

const statementHtml = whyKalos.statement.replace(/'/g, "&rsquo;").replace(". ", ".<br />");
---

<section id="why-kalos" class="proof" aria-labelledby="why-kalos-heading">
  <Image src={teamPhoto} alt="" width={1600} height={900} />
  <div class="container proof-inner">
    <span class="tag" data-reveal><span class="dot"></span>Why Kalos</span>
    <h2 id="why-kalos-heading" data-reveal>{whyKalos.heading}</h2>
    <p class="proof-intro" data-reveal>{whyKalos.intro}</p>
    <div class="proof-grid">
      <ol data-reveal="left">
        {whyKalos.items.map((item, i) => (
          <li><span class="num">{String(i + 1).padStart(2, "0")}</span>{item}</li>
        ))}
      </ol>
      <div data-reveal="right">
        <p class="statement" set:html={statementHtml} />
        <p class="proof-closing">{whyKalos.closing}</p>
      </div>
    </div>
  </div>

  <div class="logo-reel" aria-hidden="true">
    <div class="reel-track">
      {[...whyKalos.marquee, ...whyKalos.marquee].map((item, i) => (
        <span class="reel-item">
          {i % 2 === 0 && <span class="reel-dot"></span>}
          {item}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .proof {
    padding-block: 0;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .proof :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 24%;
  }

  .proof::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(10, 13, 18, 0.92) 32%, rgba(10, 13, 18, 0.35) 78%);
    z-index: 1;
  }

  .proof::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 13, 18, 0.55), transparent 40%);
    z-index: 1;
  }

  .proof-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: 5rem;
  }

  .proof h2 {
    font-size: clamp(1.9rem, 2.4vw + 1rem, 2.6rem);
    margin-top: 1.25rem;
    color: var(--dark-ink);
    max-width: 24ch;
  }

  .proof-intro {
    margin-top: 1rem;
    max-width: 62ch;
    color: var(--dark-ink-dim);
    font-size: 1rem;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }

  .proof-grid ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .proof-grid ol li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--dark-ink-dim);
  }

  .proof-grid ol li .num {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .statement {
    font-family: var(--font-display);
    font-weight: 800;
    font-style: italic;
    font-size: clamp(1.9rem, 2.6vw + 1rem, 2.75rem);
    color: var(--dark-ink);
    line-height: 1.08;
  }

  .proof-closing {
    margin-top: 1.25rem;
    color: var(--dark-ink-dim);
    font-size: 0.92rem;
    max-width: 44ch;
  }

  .logo-reel {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    border-top: 1px solid var(--dark-line);
    overflow: hidden;
    padding-block: 1.5rem;
    width: 100%;
    flex-shrink: 0;
  }

  .reel-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    animation: reel 32s linear infinite;
  }

  .reel-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--dark-ink-dim);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .reel-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 6px var(--teal);
    flex-shrink: 0;
  }

  @keyframes reel {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel-track {
      animation: none;
    }
  }
</style>
