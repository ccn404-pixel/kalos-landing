---
// src/components/Hero.astro
import { hero } from "../data/content";
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="hero__mesh" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow" data-reveal style={{ "--reveal-delay": "0s" }}>{hero.eyebrow}</p>
      <h1 id="hero-heading" data-reveal style={{ "--reveal-delay": "0.1s" }}>{hero.headline}</h1>
      <p class="hero__subhead" data-reveal style={{ "--reveal-delay": "0.2s" }}>{hero.subhead}</p>
      <div class="hero__actions" data-reveal style={{ "--reveal-delay": "0.3s" }}>
        <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
        <a href={hero.secondaryCta.href} class="btn btn-secondary">{hero.secondaryCta.label}</a>
      </div>
    </div>
    <div class="hero__graphic" data-reveal="right" style={{ "--reveal-delay": "0.15s" }} aria-hidden="true">
      <svg aria-hidden="true" viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle class="hero__ring" cx="160" cy="160" r="150" stroke="var(--teal-400)" stroke-opacity="0.3" />
        <circle class="hero__ring hero__ring--inner" cx="160" cy="160" r="100" stroke="var(--teal-400)" stroke-opacity="0.5" />
        <g class="hero__lines" stroke="var(--teal-400)" stroke-width="1.5">
          <line x1="40" y1="260" x2="120" y2="180" />
          <line x1="120" y1="180" x2="200" y2="200" />
          <line x1="200" y1="200" x2="280" y2="120" />
          <line x1="120" y1="180" x2="140" y2="90" />
        </g>
        <g class="hero__nodes" fill="var(--teal-400)">
          <circle cx="40" cy="260" r="6" style="--pulse-delay: 0s" />
          <circle cx="120" cy="180" r="6" style="--pulse-delay: 0.3s" />
          <circle cx="200" cy="200" r="6" style="--pulse-delay: 0.6s" />
          <circle cx="280" cy="120" r="6" style="--pulse-delay: 0.9s" />
          <circle cx="140" cy="90" r="6" style="--pulse-delay: 1.2s" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy-950);
    color: var(--white);
    padding-block: var(--space-24) var(--space-16);
    overflow: hidden;
  }

  .hero__mesh {
    position: absolute;
    inset: 0;
    background: var(--gradient-mesh);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--teal-400);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  .hero__subhead {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__lines line {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw-line 1.2s ease forwards 0.4s;
  }

  .hero__nodes circle {
    transform-origin: center;
    transform-box: fill-box;
    animation: pulse-node 2.4s ease-in-out infinite;
    animation-delay: var(--pulse-delay, 0s);
  }

  .hero__ring {
    transform-origin: center;
    transform-box: fill-box;
    animation: rotate-ring 40s linear infinite;
  }

  .hero__ring--inner {
    animation-duration: 28s;
    animation-direction: reverse;
  }

  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse-node {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.6);
      opacity: 0.6;
    }
  }

  @keyframes rotate-ring {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__graphic {
      order: -1;
      max-width: 240px;
      margin-inline: auto;
    }
  }
</style>
