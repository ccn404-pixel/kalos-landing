---
// src/components/StaffAugBenefits.astro
import { staffAugBenefits } from "../data/content";
---

<div class="sa-benefits" data-reveal-group>
  {staffAugBenefits.items.map((item) => (
    <div class="sa-stat" data-reveal>
      <span class="n">{item.n}</span>
      <span class="l">{item.l}</span>
      <span class="d">{item.d}</span>
    </div>
  ))}
</div>

<style>
  .sa-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--dark-line);
    margin-bottom: 3rem;
  }

  @media (max-width: 860px) {
    .sa-benefits {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .sa-benefits {
      grid-template-columns: 1fr;
    }
  }

  .sa-stat {
    padding: 1.5rem;
    border-right: 1px solid var(--dark-line);
    border-bottom: 1px solid var(--dark-line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .sa-stat:nth-child(3n) {
    border-right: none;
  }

  .sa-stat:nth-last-child(-n + 1) {
    border-bottom: none;
  }

  @media (max-width: 860px) {
    .sa-stat:nth-child(3n) {
      border-right: 1px solid var(--dark-line);
    }
    .sa-stat:nth-child(2n) {
      border-right: none;
    }
  }

  @media (max-width: 560px) {
    .sa-stat {
      border-right: none !important;
    }
    .sa-stat:last-child {
      border-bottom: none;
    }
  }

  .sa-stat .n {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--teal-dim);
    font-variant-numeric: tabular-nums;
  }

  .sa-stat .l {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--dark-ink);
    margin-top: 0.2rem;
  }

  .sa-stat .d {
    font-size: 0.8rem;
    color: var(--dark-ink-dim);
    margin-top: 0.3rem;
  }
</style>
