---
// src/components/Industries.astro
import { industries } from "../data/content";
---

<section id={industries.id} class="industries on-light" aria-labelledby="industries-heading">
  <div class="container">
    <h2 id="industries-heading">{industries.heading}</h2>
    <ul class="industries__pills" data-reveal-group>
      {industries.items.map((item) => (
        <li data-reveal>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .industries {
    padding-block: var(--space-16);
    background: var(--lavender-50);
    clip-path: polygon(0 3%, 100% 0, 100% 100%, 0 100%);
  }

  .industries__pills {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .industries__pills li {
    background: transparent;
    border: 1px solid var(--border-on-light);
    border-radius: 0;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .industries__pills li:hover {
    border-color: var(--teal-400);
    transform: translateY(-2px);
  }

</style>
