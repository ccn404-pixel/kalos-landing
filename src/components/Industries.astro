---
// src/components/Industries.astro
import { industries } from "../data/content";
---

<section id={industries.id} class="industries" aria-labelledby="industries-heading">
  <div class="container">
    <h2 id="industries-heading">{industries.heading}</h2>
    <ul class="industries__pills" data-reveal-group>
      {industries.items.map((item) => (
        <li data-reveal>{item}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .industries {
    padding-block: var(--space-16);
    background: var(--lavender-50);
    clip-path: polygon(0 3%, 100% 0, 100% 100%, 0 100%);
  }

  .industries__pills {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .industries__pills li {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border-on-light);
    border-radius: 999px;
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    font-size: var(--text-sm);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .industries__pills li:hover {
    border-color: var(--teal-400);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .industries__pills li::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgba(31, 230, 230, 0.25) 50%,
      transparent 70%
    );
    background-size: 250% 100%;
    background-position: -150% 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .industries__pills li:hover::after {
    opacity: 1;
    animation: shimmer 1.1s ease;
  }
</style>
