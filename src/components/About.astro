---
// src/components/About.astro
import { Image } from "astro:assets";
import { problem } from "../data/content";
import portraitWoman from "../assets/photos/portrait-woman.png";
---

<section id={problem.id} class="problem on-light" aria-labelledby="about-heading">
  <div class="container problem-layout">
    <div class="problem-photo" data-reveal="left">
      <Image src={portraitWoman} alt="" width={640} height={800} />
    </div>
    <div>
      <div class="section-head" data-reveal>
        <span class="tag status-off"><span class="dot"></span>{problem.tag}</span>
        <h2 id="about-heading">{problem.heading}</h2>
      </div>
      <div class="problem-grid" data-reveal-group>
        {problem.items.map((item) => (
          <div class="problem-card" data-reveal>
            <div class="ic">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="13" y="3" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="3" y="13" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.6" /><rect x="13" y="13" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.6" /></svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    padding-block: 6.5rem;
  }

  .problem-layout {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .problem-layout {
      grid-template-columns: 1fr;
    }
  }

  .problem-photo {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line-strong);
    position: relative;
    overflow: hidden;
  }

  .problem-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .problem-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 -70px 70px -40px rgba(14, 19, 24, 0.35);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }

  .problem-card {
    padding: 1.9rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .problem-card:nth-child(2n) {
    border-right: none;
  }

  .problem-grid .problem-card:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  @media (max-width: 640px) {
    .problem-card {
      border-right: none !important;
    }
    .problem-grid .problem-card:last-child {
      border-bottom: none;
    }
  }

  .problem-card .ic {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--teal-deep);
    background: var(--panel);
    flex-shrink: 0;
  }

  .problem-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .problem-card p {
    color: var(--ink-dim);
    font-size: 0.92rem;
  }
</style>
