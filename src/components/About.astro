---
// src/components/About.astro
import { Image } from "astro:assets";
import { about } from "../data/content";
import portraitWoman from "../assets/photos/portrait-woman.png";
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="container about__grid">
    <div class="about__media" data-reveal="left">
      <Image src={portraitWoman} alt="" width={640} height={800} class="about__photo" />
    </div>
    <div class="about__copy" data-reveal="right">
      <h2 id="about-heading">{about.heading}</h2>
      <p>{about.overview}</p>
      <p>{about.reliability}</p>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--navy-950);
    color: var(--white);
    padding-block: var(--space-24);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(240px, 340px) 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about__media {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .about__media :global(.about__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }

  .about__copy {
    max-width: 60ch;
  }

  .about h2 {
    font-size: var(--text-xl);
    max-width: 20ch;
  }

  @media (max-width: 780px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__media {
      max-width: 320px;
      margin-inline: auto;
    }
  }
</style>
