---
// src/components/Header.astro
import { Image } from "astro:assets";
import { site, nav, hero } from "../data/content";
import logoLockup from "../assets/logo-lockup.png";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${site.name} home`}>
      <Image src={logoLockup} alt="" width={140} height={50} />
    </a>

    <button
      type="button"
      class="site-header__toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Toggle menu</span>
      <span aria-hidden="true">☰</span>
    </button>

    <nav id="primary-nav" class="site-header__nav" data-nav-menu aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a href={hero.primaryCta.href} class="btn btn-primary site-header__cta">
        {hero.primaryCta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  import { initNavToggle } from "../scripts/nav-toggle.js";
  initNavToggle();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--navy-950);
    color: var(--white);
    border-bottom: 1px solid var(--border-on-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__logo {
    width: 140px;
    height: auto;
    display: block;
  }

  .site-header__toggle {
    background: transparent;
    border: 1px solid var(--border-on-dark);
    color: var(--white);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-lg);
    display: none;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--white);
    font-size: var(--text-sm);
  }

  .site-header__nav a:hover {
    color: var(--teal-400);
  }

  @media (max-width: 860px) {
    /* The toggle button only does anything once nav-toggle.js has attached
       its click handler, so it's only shown once the `.js` class is present.
       Without JS, there is nothing to toggle: the nav below is always
       visible in normal flow, so no button is needed. */
    :global(.js) .site-header__toggle {
      display: inline-flex;
    }

    .site-header__nav {
      background: var(--navy-950);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6);
      border-bottom: 1px solid var(--border-on-dark);
    }

    /* No-JS fallback: nav stays in normal flow and is always reachable
       below the header. Only once JS has run (documentElement gets the
       `.js` class) do we collapse it into an absolutely-positioned panel
       behind the toggle button. */
    :global(.js) .site-header__nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: none;
    }

    :global(.js) .site-header__nav[data-open] {
      display: flex;
    }

    .site-header__nav ul {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
