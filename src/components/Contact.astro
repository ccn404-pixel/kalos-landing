---
// src/components/Contact.astro
import { contact } from "../data/content";
---

<section id={contact.id} class="contact" aria-labelledby="contact-heading">
  <div class="contact-mesh" aria-hidden="true"></div>
  <div class="container contact__inner">
    <div class="contact__copy" data-reveal="left">
      <span class="tag"><span class="dot"></span>Contact</span>
      <h2 id="contact-heading">{contact.heading}</h2>
      <p>{contact.body}</p>
      <div class="contact-cta-block">
        <p class="mono contact-cta-label">{contact.ctaHeading}</p>
      </div>
      <div class="contact-direct">
        <a href={`mailto:${contact.email}`} class="mono">{contact.email}</a>
        <a href={`https://${contact.website}`} class="mono">{contact.website}</a>
      </div>
    </div>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
      class="contact__form"
      aria-labelledby="contact-heading"
      data-reveal="right"
      style={{ "--reveal-delay": "0.12s" }}
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="visually-hidden" aria-hidden="true">
        <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="interest">What are you interested in?</label>
        <select id="interest" name="interest">
          <option value="" selected disabled>Select one</option>
          {contact.interestOptions.map((option) => (
            <option value={option}>{option}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Send message</button>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-block: var(--space-16);
    background: var(--navy-950);
    color: var(--white);
    overflow: hidden;
  }

  .contact-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 55% at 15% 20%, rgba(31, 230, 230, 0.14), transparent 65%),
      radial-gradient(45% 45% at 90% 90%, rgba(139, 127, 242, 0.1), transparent 65%);
    pointer-events: none;
  }

  .contact__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
  }

  .contact h2 {
    font-size: var(--text-xl);
  }

  .contact a {
    color: var(--teal-400);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border: 1px solid var(--dark-line-strong);
    background: rgba(16, 20, 27, 0.55);
    padding: 2rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field label {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .field input,
  .field select,
  .field textarea {
    background: rgba(10, 13, 18, 0.7);
    border: 1px solid var(--dark-line-strong);
    border-radius: 0;
    color: var(--dark-ink);
    padding: 0.75rem 0.85rem;
    font-family: inherit;
    font-size: 0.92rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 1px var(--teal);
  }

  .contact-cta-label {
    margin-top: 0;
  }

  .contact-direct {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-direct a {
    color: var(--teal-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .contact-direct a:hover {
    text-decoration: underline;
  }

  .contact-direct span {
    color: var(--dark-ink-dim);
    font-size: 0.85rem;
  }

  @media (max-width: 780px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
